{
  "name": "the-learning-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:foundation": "node scripts/check-registry.mjs && node --test tests/*.test.mjs packages/*/tests/*.test.mjs",
    "typecheck": "pnpm --filter @learning-machine/web typecheck",
    "build": "pnpm --filter @learning-machine/web build",
    "check": "pnpm check:foundation && pnpm typecheck && pnpm build && pnpm content:check && pnpm web:smoke && pnpm check:boundaries && pnpm scan:secrets",
    "dev": "pnpm --filter @learning-machine/web dev",
    "preview": "pnpm --filter @learning-machine/web preview",
    "test": "node --test tests/*.test.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "demo": "node --input-type=module -e \"import {runFoundationDemonstration} from './src/learning.mjs'; console.log(JSON.stringify(runFoundationDemonstration(),null,2))\"",
    "content:check": "node scripts/check-content.mjs",
    "test:browser": "playwright test",
    "web:smoke": "node scripts/check-web-shell.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "ready": "node scripts/ready-work.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
