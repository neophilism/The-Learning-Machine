import type {LearningStage,Observation} from '@learning-machine/contracts';
import type {CompiledLearningModule} from '@learning-machine/content';
export type LearningAction = {type:'RESET'|'BACK'|'SKIP'|'REQUEST_EXPLANATION'|'REQUEST_HINT'} | {type:'ANSWER',text:string} | {type:'PROPOSE_HYPOTHESIS',text:string} | {type:'REMOVE_HYPOTHESIS',id:string}
 | {type:'COMMIT_PREDICTION',text:string,experimentId:string,hypothesisId?:string} | {type:'OBSERVE',observation:Observation}
 | {type:'RECORD_REVISION',position:'revised'|'defended',reasoning:string,testIdea:string,hypothesisId?:string}
 | {type:'RECORD_TRANSFER',novelContext:string,predictedOutcome:string,alternativeOutcome:string} | {type:'NEXT'|'CHOOSE'|'RETRY',to?:string};
export interface LearningSession {readonly sessionId:string;readonly lessonId:string;readonly releaseDigest:string;readonly nodeId:string;readonly stage:LearningStage;readonly answers:Readonly<Record<string,string>>;readonly hypotheses:readonly {id:string;text:string;nodeId:string}[];readonly predictions:readonly {id:string;nodeId:string;hypothesisId:string|null;experimentId:string;text:string;releaseDigest:string}[];readonly observations:readonly Observation[];readonly revisions:readonly {id:string;nodeId:string;hypothesisId:string|null;position:'revised'|'defended';reasoning:string;testIdea:string;releaseDigest:string}[];readonly transfers:readonly {id:string;nodeId:string;novelContext:string;predictedOutcome:string;alternativeOutcome:string;revisionId:string;releaseDigest:string}[];readonly hints:Readonly<Record<string,number>>;readonly skipped:readonly string[];readonly history:readonly string[];readonly actions:readonly LearningAction[];readonly complete:boolean;}
export function createLearningSession(compiled:CompiledLearningModule,sessionId?:string):LearningSession;
export function availableRoutes(compiled:CompiledLearningModule,session:LearningSession):Array<{to:string;when:string;available:boolean}>;
export function transitionLearningSession(compiled:CompiledLearningModule,session:LearningSession,action:LearningAction):LearningSession;
export function replayLearningActions(compiled:CompiledLearningModule,actions:LearningAction[],sessionId?:string):LearningSession;
