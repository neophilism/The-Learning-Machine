{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-machine.invalid/schema/contracts/v1",
  "title": "The Learning Machine public internal contracts v1",
  "type": "object",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "encounter",
        "hypothesis",
        "prediction",
        "experiment",
        "observation",
        "explanation",
        "challenge",
        "revision",
        "transfer",
        "reflection",
        "complete"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "prompt",
        "edges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 30
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "accessibleAlternative": {
          "type": "string"
        },
        "terminal": {
          "type": "boolean"
        },
        "questionVariants": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when",
              "prompt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "when": {
                "enum": [
                  "multiple_hypotheses",
                  "has_hypothesis",
                  "has_prediction",
                  "computed_observation",
                  "has_observation",
                  "no_observation",
                  "always"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "triggerTerms",
              "competingApproach"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "triggerTerms": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{2,40}$"
                }
              },
              "competingApproach": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "enum": [
            "always",
            "correct",
            "retry",
            "alternative",
            "on_request"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "title",
        "startNodeId",
        "nodes",
        "concepts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startNodeId": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "experimentId",
        "runId",
        "kind",
        "description"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "experimentId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "measured",
            "computed",
            "simulated",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "version",
        "title",
        "capabilities",
        "timeoutMs"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "canvas",
              "audio",
              "camera",
              "ml",
              "worker",
              "keyboard"
            ]
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    },
    "legalScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "status",
        "jurisdiction",
        "evaluationDate",
        "facts",
        "sourceIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "current",
            "proposed",
            "hypothetical"
          ]
        },
        "jurisdiction": {
          "const": "US-federal"
        },
        "evaluationDate": {
          "type": "string",
          "format": "date"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actors",
            "works",
            "access",
            "copying",
            "retention",
            "teaching",
            "outputs",
            "declaredUnknowns"
          ],
          "properties": {
            "actors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "role"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "role": {
                    "enum": [
                      "learner",
                      "creator",
                      "rights-holder",
                      "platform",
                      "institution",
                      "other"
                    ]
                  }
                }
              }
            },
            "works": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "copyrightStatus",
                  "rightsHolderActorId"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "enum": [
                      "text",
                      "image",
                      "audio",
                      "video",
                      "software",
                      "dataset",
                      "other"
                    ]
                  },
                  "copyrightStatus": {
                    "enum": [
                      "protected",
                      "public-domain",
                      "licensed",
                      "unknown"
                    ]
                  },
                  "rightsHolderActorId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "access": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "lawful",
                "sourceActorId"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "purchase",
                    "license",
                    "borrow",
                    "stream",
                    "public-source",
                    "unauthorized",
                    "unknown"
                  ]
                },
                "lawful": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "sourceActorId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "copying": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "performed",
                "inputWorkIds",
                "intermediateCopies"
              ],
              "properties": {
                "performed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "inputWorkIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "intermediateCopies": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "retained",
                "durationDays"
              ],
              "properties": {
                "retained": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "durationDays": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 36500
                }
              }
            },
            "teaching": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "performed",
                "learnerActorIds"
              ],
              "properties": {
                "performed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "learnerActorIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "created",
                "distributed",
                "containsProtectedExpression"
              ],
              "properties": {
                "created": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "distributed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "containsProtectedExpression": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "declaredUnknowns": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "source",
        "conditions",
        "effect",
        "sourceIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "current",
            "proposed",
            "learner"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "effect": {
          "enum": [
            "permit",
            "restrict",
            "conditional",
            "unresolved"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "digest",
        "modules",
        "publishedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
