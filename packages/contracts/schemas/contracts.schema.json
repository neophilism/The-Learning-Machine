{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-machine.invalid/schema/contracts/v1",
  "title": "The Learning Machine public internal contracts v1",
  "type": "object",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "encounter",
        "hypothesis",
        "prediction",
        "experiment",
        "observation",
        "explanation",
        "challenge",
        "revision",
        "transfer",
        "reflection",
        "complete"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "prompt",
        "edges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 30
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "accessibleAlternative": {
          "type": "string"
        },
        "terminal": {
          "type": "boolean"
        },
        "questionVariants": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when",
              "prompt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "when": {
                "enum": [
                  "multiple_hypotheses",
                  "has_hypothesis",
                  "has_prediction",
                  "computed_observation",
                  "has_observation",
                  "no_observation",
                  "always"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "enum": [
            "always",
            "correct",
            "retry",
            "alternative",
            "on_request"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "title",
        "startNodeId",
        "nodes",
        "concepts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startNodeId": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "experimentId",
        "runId",
        "kind",
        "description"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "experimentId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "measured",
            "computed",
            "simulated",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "version",
        "title",
        "capabilities",
        "timeoutMs"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "canvas",
              "audio",
              "camera",
              "ml",
              "worker",
              "keyboard"
            ]
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    },
    "legalScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "status",
        "facts",
        "sourceIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "current",
            "proposed",
            "hypothetical"
          ]
        },
        "facts": {
          "type": "object"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "source",
        "conditions",
        "effect",
        "sourceIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "current",
            "proposed",
            "learner"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "effect": {
          "enum": [
            "permit",
            "restrict",
            "conditional",
            "unresolved"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "digest",
        "modules",
        "publishedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
