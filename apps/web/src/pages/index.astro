---
import {compileLearningModule} from '@learning-machine/content';
import lesson from '../../../../content/modules/intro-visual-reasoning.json';
import Discovery from '../components/Discovery.tsx';
import '../styles/global.css';
const compiled=compileLearningModule(lesson);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="Learn by hypothesizing, experimenting, observing and revising your understanding."/>
<title>The Learning Machine — Learn Through Discovery</title>
</head>
<body><div class="shell">
<header class="site-header"><a class="brand" href="/" aria-label="The Learning Machine homepage"><span class="brand-mark" aria-hidden="true">◉</span> The Learning Machine</a><span class="site-label">An experimental classroom</span></header>
<main id="main-content">
<section class="intro" aria-labelledby="intro-title"><p class="eyebrow">Experience, experiment, discover</p>
<h1 id="intro-title">Learning begins with a question, not an answer.</h1>
<p class="lede">Try your own solution. Predict what will happen. Explore alternatives and change your mind—or explain why you wouldn't. There is no political agreement score.</p></section>
<Discovery client:load compiled={compiled}/>
<p><a href="/vision">Build a reproducible geometric scene in the vision laboratory →</a></p>
<p><a href="/shapes">Create your own training examples in the drawing laboratory →</a></p>
<section class="about" aria-labelledby="about-title"><h2 id="about-title">What is this?</h2>
<p>A Socratic environment for exploring questions behind the proposed Right to Learn and Ephemeral Processing Act. This module runs real bounded pixel comparisons in your browser. Camera use remains optional and local; audio, later machine-learning modules and legal evaluation have separate readiness gates.</p></section>
</main>
<footer>Independent educational work. No account or personal-data submission required.</footer>
</div></body></html>
